# Copy to .env and edit. Everything is optional.
LEGAL_AGENT_BACKEND=auto          # auto | openai | local | offline
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MAX_SPEND_USD=0.75                # per analysis, estimated; the agent falls back to free methods beyond this
# Prices (USD per 1M tokens) are only used for the cost estimate. Check https://openai.com/api/pricing
PRICE_IN_PER_M=0.15
PRICE_OUT_PER_M=0.60
PERSPECTIVE=
SUMMARY_WORDS=180
# LOCAL_SUMMARIZER=facebook/bart-large-cnn
# LOCAL_NLI=facebook/bart-large-mnli
# LOCAL_EMBEDDER=nlpaueb/legal-bert-base-uncased

# Optional: stronger model ONLY for rewriting risky clauses (about 8 short calls per document).
# OPENAI_REWRITE_MODEL=
# PRICE_IN_REWRITE_PER_M=      # USD per 1M tokens for that model (0/empty = assume 20x the base price for the estimate)
# PRICE_OUT_REWRITE_PER_M=
